# Frontend – HPK Admin Central

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret

# ZITADEL OIDC configuration
ZITADEL_ISSUER=https://your-zitadel-domain.zitadel.cloud
ZITADEL_CLIENT_ID=your-zitadel-client-id
ZITADEL_CLIENT_SECRET=your-zitadel-client-secret

# Sub-system public URLs (exposed to the browser)
NEXT_PUBLIC_WAREHOUSE_URL=http://warehouse.hospital.internal
NEXT_PUBLIC_PALLIATIVE_URL=http://palliative.hospital.internal
NEXT_PUBLIC_PHARMACY_URL=http://pharmacy.hospital.internal
NEXT_PUBLIC_ADMIN_URL=http://admin.hospital.internal
